{% extends 'base.html.twig' %}

{% block title %}Gestionnaire{% endblock %}

{% block body %}
    <section class="p-2">
      
        <div class="flex flex-col md:flex-row justify-center gap-4 mb-6 w-full">

            <div
                class="w-[40px] h-[40px] rounded-full
                       login-icon flex items-center justify-center
                       text-2xl font-bold transition
                       hover:ring-4 hover:ring-white/40"
            >
                {{ user.userIdentifier|first|upper }}
            </div>
      
            <div
                class="flex w-full gap-4  flex-wrap
                {{ check ? 'justify-between' : 'justify-end' }}"
            >
                {% include 'gestionnaire/link/link.html.twig' with {'check': check} %}
            </div>
          
        </div>
     
        {% if check %}
 
            <div class="flex flex-col min-[1400px]:grid min-[1400px]:grid-cols-10 gap-4">
                <div class="max-[600px]:block hidden font-semibold">
                    <h2>Mes dossiers</h2>
                </div>
                {% if folders|length > 0 %}
                    <div class="min-[1400px]:col-span-3 flex flex-col gap-4 dashboards w-full min-w-0">

                        <div class="hidden min-[600px]:block w-full min-w-0">
                            <table class="w-full table-fixed text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-slate-600">
                                        <th class="w-[25%] px-3 py-2">
                                            Favoris
                                        </th>
                                        <th class="w-[25%] px-3 py-2">
                                            Nom dossier
                                        </th>
                                        <th class="w-[25%] px-3 py-2 text-center">
                                            Modifier
                                        </th>
                                        <th class="w-[25%] px-3 py-2 text-center">
                                            Supprimer
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {% for folder in folders %}
                                        <tr class="border-b last:border-b-0">

                                            <td class="px-3 py-3">
                                                <button
                                                    type="button"
                                                    class="hover:text-yellow-400 transition"
                                                    aria-label="Ajouter aux favoris"
                                                >
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                            </td>

                                            <td class="px-3 py-3 min-w-0">
                                                <a
                                                    href="{{ path('app_gestionnaire_folder', {id: folder.id}) }}"
                                                    class="block truncate hover:underline"
                                                    title="{{ folder.name }}"
                                                >
                                                    {{ folder.name }}
                                                </a>
                                            </td>

                                            <td class="px-3 py-3 text-center">
                                                <a
                                                    href="{{ path('app_gestionnaire_update_folder', {id: folder.id}) }}"
                                                    class="inline-flex items-center justify-center p-2 hover:text-blue-600 transition"
                                                    aria-label="Modifier le dossier"
                                                >
                                                    <i class="fa-solid fa-file-pen"></i>
                                                </a>
                                            </td>

                                            <td class="px-3 py-3 text-center">
                                                <form
                                                    method="post"
                                                    action=""
                                                    onsubmit="return confirm('Confirmer la suppression ?');"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="inline-flex items-center justify-center p-2 hover:text-red-600 transition"
                                                        aria-label="Supprimer le dossier"
                                                    >
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>

                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
               
                        <div class="min-[600px]:hidden flex flex-col gap-3 w-full min-w-0">

                            {% for folder in folders %}

                                <div class="w-full min-w-0 border-b border-t border-mobile-dashboards p-3">

                                    <div class="flex items-center gap-3 min-w-0">

                                        <button
                                            type="button"
                                            class="shrink-0 p-2 hover:text-yellow-400 transition"
                                            aria-label="Ajouter aux favoris"
                                        >
                                            <i class="fa-regular fa-star"></i>
                                        </button>

                                        <a
                                            href="{{ path('app_gestionnaire_folder', {id: folder.id}) }}"
                                            class="flex-1 min-w-0 truncate font-medium hover:underline"
                                            title="{{ folder.name }}"
                                        >
                                            {{ folder.name }}
                                        </a>

                                        <div class="flex items-center gap-1 shrink-0">

                                            <a
                                                href="{{ path('app_gestionnaire_update_folder', {id: folder.id}) }}"
                                                class="p-2 hover:text-blue-600 transition"
                                                aria-label="Modifier le dossier"
                                            >
                                                <i class="fa-solid fa-file-pen"></i>
                                            </a>

                                            <form
                                                method="post"
                                                action=""
                                                onsubmit="return confirm('Confirmer la suppression ?');"
                                            >
                                                <button
                                                    type="submit"
                                                    class="p-2 hover:text-red-600 transition"
                                                    aria-label="Supprimer le dossier"
                                                >
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>

                                        </div>

                                    </div>

                                </div>

                            {% endfor %}

                        </div>

                    </div>
                {% endif %}
                <div class="max-[600px]:block hidden font-semibold">
                    <h2>Mes mots de passes</h2>
                </div>
                <div class="  {% if folders|length > 0 %} min-[1400px]:col-span-7 {% else %} min-[1400px]:col-span-10 {% endif %}">  
                    {% include 'gestionnaire/list/list.html.twig' with {'datas': datas, 'folder': null} %}
                </div>
          
            </div>
        {% else %}

            <div class="flex flex-col md:flex-row gap-4 w-full mt-8">

                {% if not check %}

                    {{ render(
                        controller(
                            'App\\Controller\\MasterKey\\MasterKeyController::loginMasterKey'
                        )
                    ) }}

                {% elseif masterKeyHash is empty %}

                    {{ render(
                        controller(
                            'App\\Controller\\MasterKey\\MasterKeyController::addMasterKey'
                        )
                    ) }}

                {% endif %}
                <div class="dashboards rounded p-4 border-2 gap-4 flex flex-col w-full md:w-1/3">
                    <h2 class="text-white text-xl">Explication</h2>
                    <p class="text-white text-left overflow-y-auto h-64">
                        Gestionnaire de mots de passe 100% local. Commencez par créer un mot de passe Maître, puis connectez-vous avec celui-ci.
                        Lors de l'ajout d'un mot de passe, indiquez l'URL exacte du formulaire de connexion. Si le formulaire s'ouvre dans une popup, renseignez l'URL de la page où vous avez cliqué.
                        Si cela ne fonctionne pas, certaines sécurités du site peuvent bloquer l'intégration. L'extension liée à ce gestionnaire complète automatiquement vos données dans le formulaire de connexion.
                        Vos mots de passe sont évidemment chiffrés et stockés localement, garantissant une sécurité totale.
                    </p>
                </div>
                <div
                    class="dashboards rounded-xl p-6 flex flex-col items-center
                justify-center text-center w-full md:w-1/3"
                >
                    <div
                        class="w-16 h-16 mb-3 rounded-full
                       login-icon flex items-center justify-center
                       text-2xl font-bold transition
                       hover:ring-4 hover:ring-white/40"
                    >
                        {{ user.userIdentifier|first|upper }}
                    </div>

                    <div class="font-semibold text-lg">
                        {{ user.name|upper }}
                    </div>
                    <div class="text-sm opacity-80">
                        {{ user.userIdentifier }}
                    </div>
                </div>
               

            </div>
        {% endif %}
    </section>
{% endblock %}
