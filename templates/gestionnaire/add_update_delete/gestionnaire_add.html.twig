{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}
	<style></style>
	
	<section class="min-h-screen flex items-center justify-center text-center flex flex-col px-[5%] md:px-[30%]">
		<div class="flex flex-wrap gap-4 justify-end w-full md:pr-6">
		
			<a href="javascript:history.back()" class="button-action px-4 rounded py-2 transition">
				RETOUR
			</a>

		</div>
		<div class="md:p-6 mt-6 md:mt-0 rounded text-white w-full overflow-x-auto">

			<form class="dashboards p-4 text-left flex flex-col gap-4" method="POST" action="{{ path('app_gestionnaire_add',{id: id}) }}">
				
					<div class="flex flex-col w-full">
						<label for="site" class="mb-1">
							Nom du site
						</label>
						<input id="site" type="text" name="site" class="p-1 rounded bg-white text-black " required>
					</div>
					<div class="flex flex-col w-full">
						<label for="url" class="mb-1">
							Url du site
						</label>
						<input id="url" type="text" name="url" class="p-1 rounded bg-white text-black " required>
					</div>
				
				<div class="flex flex-col">
					<label for="identifier" class="mb-1">
						Identifiant du site
					</label>
					<input id="identifier" type="text" name="identifier" class="p-1 rounded bg-white text-black " required>
				</div>
				<div class="flex flex-col">
					<label for="password" class="mb-1">
						Mot de passe du site
					</label>
					<input id="password" type="password" name="password" class="p-1 rounded bg-white text-black " required>
				</div>
				<div class="flex flex-col">
					<label for="folder" class="mb-1">
						Dossier
					</label>

					<select
                        id="folder"
                        name="folder"
                        class="p-1 rounded bg-white text-black"
                    >
                        <option value="">Aucun dossier</option>

                        {% for folder in folders %}
                            <option
                                value="{{ folder.id }}"
                                {% if folderUrl and folderUrl.id == folder.id %}selected{% endif %}
                            >
                                {{ folder.name }}
                            </option>
                        {% else %}
                            <option value="">Aucun dossier disponible</option>
                        {% endfor %}
                    </select>
				</div>

				<button type="submit" class="button-action px-2 text-white rounded py-2 transition">
					Ajouter
				</button>
			</form>
		</div>
	</section>
{% endblock %}
