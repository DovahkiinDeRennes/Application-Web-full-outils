{% extends 'base.html.twig' %}

{% block title %}Modification mot de passe{% endblock %}

{% block body %}


    <section class="min-h-screen flex items-center justify-center text-center flex flex-col px-[5%] md:px-[30%]">
        <div class="flex flex-wrap gap-4 justify-end w-full md:pr-6">


            <a href="{{ path('app_gestionnaire') }}" class="button-action px-4 rounded py-2 transition">
                RETOUR
            </a>

        </div>
        <div class="md:p-6 mt-6 md:mt-0 rounded text-white w-full overflow-x-auto">

            <form
                class="text-left flex flex-col gap-4 dashboards p-4"
                method="POST"
                action="{{ path('app_gestionnaire_update_folder', { id: folderEntry.id }) }}"
            >
              
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col w-full">
                        <label for="name" class="mb-1">
                            Nom du Dossier
                        </label>
                        <input
                            id="name"
                            type="text"
                            name="name"
                            value="{{ folderEntry.name }}"
                            class="p-1 rounded bg-white text-black"
                            required
                        >
                    </div>

                    <div class="flex flex-col w-full">
                        <label for="ref" class="mb-1">
                            Ref du dossier
                        </label>
                        <input
                            id="ref"
                            type="text"
                            name="ref"
                            value="{{ folderEntry.ref }}"
                            class="p-1 rounded bg-white text-black "
                            required
                        >
                    </div>
                </div>

                <button
                    type="submit"
                    class="px-4 button-action text-white rounded py-2 transition"
                >
                    Mettre à jour
                </button>

            </form>
        </div>
    </section>
{% endblock %}
