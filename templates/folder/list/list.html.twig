<div class="dashboards w-full min-w-0">

    <div class="hidden min-[600px]:block w-full min-w-0">

        <table class="w-full table-fixed text-left border-collapse">

            <thead>
                <tr class="">
                    <th class="w-[10%] px-3 py-2">
                        Favoris
                    </th>

                    <th class="w-[25%] px-3 py-2">
                        URL + Site
                    </th>

                    <th class="w-[20%] px-3 py-2">
                        Identifiant
                    </th>

                    <th class="w-[25%] px-3 py-2">
                        Mot de passe
                    </th>

                    <th class="w-[10%] px-3 py-2 text-center">
                        Modifier
                    </th>

                    <th class="w-[10%] px-3 py-2 text-center">
                        Supprimer
                    </th>
                </tr>
            </thead>

            <tbody>

                {% for data in datas %}

                    <tr class="">

                        <td class="px-3 py-3">
                            <button
                                type="button"
                                class="p-2 hover:text-yellow-400 transition"
                                aria-label="Ajouter aux favoris"
                            >
                                <i class="fa-regular fa-star"></i>
                            </button>
                        </td>

                        <td class="px-3 py-3 min-w-0">

                            <a
                                target="_blank"
                                rel="noopener noreferrer"
                                href="{{ data.url }}"
                                class="block truncate hover:underline"
                                title="{{ data.site }}"
                            >
                                {{ data.site }}
                            </a>

                        </td>

                        <td class="px-3 py-3 min-w-0">

                            <span
                                class="block truncate"
                                title="{{ data.identifier }}"
                            >
                                {{ data.identifier }}
                            </span>

                        </td>

                        <td
                            class="copiable px-3 py-3 password-hidden min-w-0 cursor-pointer hover:text-red-600 transition"
                            data-value="{{ data.password }}"
                            title="Cliquer pour copier"
                        >
                            <span class="block truncate">
                                {% if data.password|length > 15 %}
                                    <p class="">{{ data.password|slice(0, 15) }}...</p>
                                {% else %}
                                    <p class="">{{ data.password }}</p>
                                {% endif %}
                            </span>
                        </td>

                        <td class="px-3 py-3 text-center">

                            <a
                                href="{{ path('app_gestionnaire_update', {
                                    uuid: data.uuid,
                                    id: id
                                }) }}"
                                class="inline-flex items-center justify-center p-2 hover:text-blue-600 transition"
                                aria-label="Modifier"
                            >
                                <i class="fa-solid fa-file-pen"></i>
                            </a>

                        </td>

                        <td class="px-3 py-3 text-center">

                            <form
                                method="post"
                                action="{{ path('app_gestionnaire_delete', {
                                    uuid: data.uuid,
                                    id: id
                                }) }}"
                                onsubmit="return confirm('Confirmer la suppression ?');"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete' ~ data.uuid) }}"
                                >

                                <button
                                    type="submit"
                                    class="inline-flex items-center justify-center p-2 hover:text-red-600 transition"
                                    aria-label="Supprimer"
                                >
                                    <i class="fa-solid fa-trash"></i>
                                </button>

                            </form>

                        </td>

                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

    <div class="min-[600px]:hidden flex flex-col gap-3 w-full min-w-0">

        {% for data in datas %}

            <div
                class="w-full min-w-0 rounded-lg border-b border-t border-mobile-dashboards p-3"
            >

                <div class="flex items-center gap-2 min-w-0">

                    <button
                        type="button"
                        class="shrink-0 p-2 hover:text-yellow-400 transition"
                        aria-label="Ajouter aux favoris"
                    >
                        <i class="fa-regular fa-star"></i>
                    </button>

                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="{{ data.url }}"
                        class="flex-1 min-w-0 truncate font-medium hover:underline"
                        title="{{ data.site }}"
                    >
                        {{ data.site }}
                    </a>

                    <div class="flex items-center gap-1 shrink-0">

                        <a
                            href="{{ path('app_gestionnaire_update', {
                                uuid: data.uuid,
                                id: id
                            }) }}"
                            class="p-2 hover:text-blue-600 transition"
                            aria-label="Modifier"
                        >
                            <i class="fa-solid fa-file-pen"></i>
                        </a>

                        <form
                            method="post"
                            action="{{ path('app_gestionnaire_delete', {
                                uuid: data.uuid,
                                id: id
                            }) }}"
                            onsubmit="return confirm('Confirmer la suppression ?');"
                        >

                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('delete' ~ data.uuid) }}"
                            >

                            <button
                                type="submit"
                                class="p-2 hover:text-red-600 transition"
                                aria-label="Supprimer"
                            >
                                <i class="fa-solid fa-trash"></i>
                            </button>

                        </form>

                    </div>

                </div>

                <div class="mt-3 space-y-2 min-w-0">

                    <div class="min-w-0">

                        <div class="text-xs text-mobile-dashboards mb-1">
                            Identifiant
                        </div>

                        <div
                            class="truncate"
                            title="{{ data.identifier }}"
                        >
                            {{ data.identifier }}
                        </div>

                    </div>

                    <div class="min-w-0">

                        <div class="text-xs text-mobile-dashboards mb-1">
                            Mot de passe
                        </div>

                        <div
                            class="copiable password-hidden truncate cursor-pointer hover:text-red-600 transition"
                            data-value="{{ data.password }}"
                            title="Cliquer pour copier"
                        >
                            {% if data.password|length > 15 %}
                                <p class="">{{ data.password|slice(0, 15) }}...</p>
                            {% else %}
                                <p class="">{{ data.password }}</p>
                            {% endif %}
                        </div>

                    </div>

                    <div class="min-w-0">

                        <div class="text-xs text-mobile-dashboards mb-1">
                            URL
                        </div>

                        <a
                            target="_blank"
                            rel="noopener noreferrer"
                            href="{{ data.url }}"
                            class="block truncate text-sm hover:underline"
                            title="{{ data.url }}"
                        >
                            {{ data.url }}
                        </a>

                    </div>

                </div>

            </div>

        {% endfor %}

    </div>

</div>
