{% extends 'base.html.twig' %}

{% block title %}Mes dossiers de mot de passe{% endblock %}

{% block body %}
    <section class="p-2">
        <div class="flex flex-col md:flex-row justify-center gap-4 mb-6 w-full">

            <div
                class="w-[40px] h-[40px] rounded-full
                       login-icon flex items-center justify-center
                       text-2xl font-bold transition
                       hover:ring-4 hover:ring-white/40"
            >
                {{ user.userIdentifier|first|upper }}
            </div>
      
            <div
                class="flex w-full gap-4  flex-wrap
                {{ check ? 'justify-between' : 'justify-end' }}"
            >
                {% include 'folder/link/link.html.twig' with {'check': check} %}
            </div>
          
        </div>
       
        <div class="flex flex-col min-[1400px]:grid min-[1400px]:grid-cols-10 gap-4">
            <div class="max-[600px]:block hidden font-semibold">
                <h2>Mes dossiers</h2>
            </div>
            {% if folders|length > 0 %}
                <div class="min-[1400px]:col-span-3 flex flex-col gap-4 dashboards w-full min-w-0">

                    <div class="hidden min-[600px]:block w-full min-w-0">
                        <table class="w-full table-fixed text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-600">
                                    <th class="w-[25%] px-3 py-2">
                                        Favoris
                                    </th>
                                    <th class="w-[25%] px-3 py-2">
                                        Nom dossier
                                    </th>
                                    <th class="w-[25%] px-3 py-2 text-center">
                                        Modifier
                                    </th>
                                    <th class="w-[25%] px-3 py-2 text-center">
                                        Supprimer
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for folder in folders %}
                                    <tr class="border-b border-slate-700 last:border-b-0">

                                        <td class="px-3 py-3">
                                            <button
                                                type="button"
                                                class="hover:text-yellow-400 transition"
                                                aria-label="Ajouter aux favoris"
                                            >
                                                <i class="fa-regular fa-star"></i>
                                            </button>
                                        </td>

                                        <td class="px-3 py-3 min-w-0">
                                            <a
                                                href="{{ path('app_gestionnaire_folder', {id: folder.id}) }}"
                                                class="block truncate hover:underline"
                                                title="{{ folder.name }}"
                                            >
                                                {{ folder.name }}
                                            </a>
                                        </td>

                                        <td class="px-3 py-3 text-center">
                                            <a
                                                href="{{ path('app_gestionnaire_update_folder', {id: folder.id}) }}"
                                                class="inline-flex items-center justify-center p-2 button-update transition"
                                                aria-label="Modifier le dossier"
                                            >
                                                <i class="fa-solid fa-file-pen"></i>
                                            </a>
                                        </td>

                                        <td class="px-3 py-3 text-center">
                                            <form
                                                method="post"
                                                action=""
                                                onsubmit="return confirm('Confirmer la suppression ?');"
                                            >
                                                <button
                                                    type="submit"
                                                    class="inline-flex items-center justify-center p-2 button-delete transition"
                                                    aria-label="Supprimer le dossier"
                                                >
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>

                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
               
                    <div class="min-[600px]:hidden flex flex-col gap-3 w-full min-w-0">

                        {% for folder in folders %}

                            <div class="w-full min-w-0 border-b border-t border-mobile-dashboards p-3">

                                <div class="flex items-center gap-3 min-w-0">

                                    <button
                                        type="button"
                                        class="shrink-0 p-2 hover:text-yellow-400 transition"
                                        aria-label="Ajouter aux favoris"
                                    >
                                        <i class="fa-regular fa-star"></i>
                                    </button>

                                    <a
                                        href="{{ path('app_gestionnaire_folder', {id: folder.id}) }}"
                                        class="flex-1 min-w-0 truncate font-medium hover:underline"
                                        title="{{ folder.name }}"
                                    >
                                        {{ folder.name }}
                                    </a>

                                    <div class="flex items-center gap-1 shrink-0">

                                        <a
                                            href="{{ path('app_gestionnaire_update_folder', {id: folder.id}) }}"
                                            class="p-2 button-update transition"
                                            aria-label="Modifier le dossier"
                                        >
                                            <i class="fa-solid fa-file-pen"></i>
                                        </a>

                                        <form
                                            method="post"
                                            action=""
                                            onsubmit="return confirm('Confirmer la suppression ?');"
                                        >
                                            <button
                                                type="submit"
                                                class="p-2 button-delete transition"
                                                aria-label="Supprimer le dossier"
                                            >
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>

                                    </div>

                                </div>

                            </div>

                        {% endfor %}

                    </div>

                </div>
            {% endif %}
            <div class="max-[600px]:block hidden font-semibold">
                <h2>Mes mots de passes</h2>
            </div>
            <div class="  {% if folders|length > 0 %} min-[1400px]:col-span-7 {% else %} min-[1400px]:col-span-10 {% endif %}">  
                {% include 'folder/list/list.html.twig' with {'datas': datas, 'folder': null} %}
            </div>
          
        </div>
    </section>
{% endblock %}
